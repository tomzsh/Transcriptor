<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".TranscriptorApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Transcriptor"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/diagnostics_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".transcription.TranscriptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
        <service
            android:name=".inference.NativeInferenceService"
            android:process=":inference"
            android:exported="false" />
        <service
            android:name=".speaker.SherpaDiarizationWorkerService"
            android:process=":speaker_diarization"
            android:exported="false" />
    </application>
</manifest>
